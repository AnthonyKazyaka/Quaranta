rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Each signed-in (anonymous) user owns their saved games.
    // Written by mobile/src/services/gameRepository.ts.
    match /users/{userId}/games/{gameId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.status in ['playing', 'roundOver', 'gameOver']
        && request.resource.data.phaseIndex is int
        && request.resource.data.phaseIndex >= 0
        && request.resource.data.phaseIndex < 8
        && request.resource.data.state is string
        && request.resource.data.state.size() < 200000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
